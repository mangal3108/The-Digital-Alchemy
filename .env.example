# ---------------------------------------------------------------------------
# Copy to .env and fill in. Nothing here has a fabricated default — an absent
# value disables the feature rather than guessing at one.
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# MongoDB. The connection string MUST include a database name — Prisma rejects
# a bare cluster URI, and Atlas does not put one in the string it gives you:
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/digitalalchemy?retryWrites=true&w=majority"
#
# Schema changes are applied with `npx prisma db push`; MongoDB has no
# migration history, so there is no `migrate dev` step.

# Site ----------------------------------------------------------------------
# Canonical origin. Used for canonical URLs, the sitemap and Open Graph tags.
# Inlined at build time, so a change needs a rebuild.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# First administrator -------------------------------------------------------
# Read by `npm run db:seed`. Leave ADMIN_PASSWORD blank and a strong one is
# generated and printed once — it is hashed, never recoverable.
ADMIN_EMAIL=""
ADMIN_NAME="Administrator"
ADMIN_PASSWORD=""

# Email ---------------------------------------------------------------------
# Without SMTP_HOST, SMTP_USER and SMTP_PASSWORD the mailer logs the message
# and reports success. Enquiries are stored in the database either way, so a
# mail outage can never lose a lead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="The Digital Alchemy <hello@example.com>"

# Where enquiry notifications are sent. Falls back to the contact email set in
# /admin/settings.
LEAD_NOTIFICATION_EMAIL=""

# Assistant -----------------------------------------------------------------
# Without an API key the assistant answers from its built-in knowledge base
# only. It is never given client names, metrics or outcomes to quote.
BHADAWAR_AI_API_KEY=""
BHADAWAR_AI_PROVIDER=""
BHADAWAR_AI_MODEL=""

# Analytics -----------------------------------------------------------------
# Prefer setting these in /admin/settings so they can change without a deploy.
# Either way, nothing loads until the visitor consents.
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_CLARITY_ID=""
