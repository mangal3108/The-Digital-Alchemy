// The Digital Alchemy — content, leads and administration schema.
//
// PORTABILITY NOTE
// The provider below is `sqlite` so the project runs and can be verified with
// no external database. The schema is deliberately written to be *portable*:
//   - no native enums (status fields are String, validated by Zod)
//   - no Json columns (structured values are TEXT holding JSON)
//   - no scalar lists
// Moving to PostgreSQL for production is therefore a two-line change:
//   1. set provider = "postgresql"
//   2. point DATABASE_URL at the Postgres instance
// then run `npx prisma migrate deploy`. See README.md → Database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Access control
// ---------------------------------------------------------------------------

/// role: SUPER_ADMIN | ADMIN | EDITOR | MARKETING
model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("EDITOR")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions      Session[]
  auditLogs     AuditLog[]
  uploadedMedia Media[]    @relation("MediaUploader")
  authoredPosts Post[]     @relation("PostAuthor")
  assignedLeads Lead[]     @relation("LeadAssignee")
  leadNotes     LeadNote[]

  @@index([role])
}

/// Server-side sessions so an administrator can be logged out immediately
/// rather than waiting for a stateless token to expire.
model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  tokenHash String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Records consequential actions. Written on publish, delete, permission and
/// lead-status changes so there is an account of who did what.
model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  action    String
  entity    String
  entityId  String?  @db.ObjectId
  summary   String?
  /// JSON TEXT — before/after detail where useful
  meta      String?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Site configuration
// ---------------------------------------------------------------------------

/// Central key/value configuration. Contact details, social profiles and
/// analytics IDs live here so they are never duplicated across components.
model SiteSetting {
  /// A natural string key rather than an ObjectId. MongoDB allows any scalar
  /// as `_id`, and these rows are addressed by name everywhere.
  key       String   @id @map("_id")
  value     String   @default("")
  group     String   @default("general")
  label     String
  /// text | textarea | email | tel | url | boolean | number | media
  type      String   @default("text")
  hint      String?
  order     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([group])
}

/// CMS-driven company numbers. Every metric is unpublished by default so no
/// invented statistic can reach the site — an administrator must enter a real
/// value and switch it on.
model Metric {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  label       String
  value       String   @default("")
  prefix      String?
  suffix      String?
  note        String?
  isPublished Boolean  @default(false)
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([isPublished, order])
}

/// Per-path SEO overrides edited from the admin SEO editor.
model SeoOverride {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  path          String   @unique
  title         String?
  description   String?
  canonical     String?
  ogTitle       String?
  ogDescription String?
  ogImageId     String?  @db.ObjectId
  noindex       Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  ogImage Media? @relation("SeoOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
}

/// Redirect manager — essential while migrating away from the WordPress URLs.
model Redirect {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  source      String   @unique
  destination String
  statusCode  Int      @default(301)
  isActive    Boolean  @default(true)
  note        String?
  createdAt   DateTime @default(now())

  @@index([isActive])
}

/// Extra navigation entries an administrator can add without a code change.
/// The primary menu is generated from the service registry; this supplements it.
model NavigationItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  location  String   @default("footer")
  label     String
  href      String
  group     String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([location, order])
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

model Media {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  url          String
  storagePath  String
  filename     String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String   @default("")
  title        String?
  caption      String?
  uploadedById String?  @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy User? @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  // Usage references — checked before deletion so media still in use cannot be
  // removed by accident.
  clientLogos       Client[]       @relation("ClientLogo")
  projectHeroes     Project[]      @relation("ProjectHero")
  projectMedia      ProjectMedia[]
  productLogos      Product[]      @relation("ProductLogo")
  productShots      ProductMedia[]
  testimonialPhotos Testimonial[]  @relation("TestimonialPhoto")
  teamPhotos        TeamMember[]   @relation("TeamPhoto")
  postHeroes        Post[]         @relation("PostHero")
  seoImages         SeoOverride[]  @relation("SeoOgImage")

  @@index([createdAt])
  @@index([mimeType])
}

// ---------------------------------------------------------------------------
// Clients, work and products
// ---------------------------------------------------------------------------

model Client {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  logoId      String?  @db.ObjectId
  website     String?
  country     String?
  industry    String?
  /// Shown on the logo strip only when the client has approved it.
  showLogo    Boolean  @default(false)
  isPublished Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logo         Media?        @relation("ClientLogo", fields: [logoId], references: [id], onDelete: SetNull)
  projects     Project[]
  testimonials Testimonial[]

  @@index([isPublished, order])
}

/// status: DRAFT | PUBLISHED | ARCHIVED
model Project {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  slug         String    @unique
  title        String
  clientId     String?   @db.ObjectId
  /// Free-text client name for projects where no Client record exists.
  clientName   String?
  category     String    @default("web")
  industry     String?
  country      String?
  year         Int?
  durationText String?
  summary      String    @default("")
  challenge    String?
  strategy     String?
  research     String?
  design       String?
  technology   String?
  development  String?
  marketing    String?
  outcome      String?
  websiteUrl   String?
  /// JSON TEXT — array of service slugs
  services     String    @default("[]")
  /// JSON TEXT — array of technology keys
  techStack    String    @default("[]")
  heroId       String?   @db.ObjectId
  isFeatured   Boolean   @default(false)
  status       String    @default("DRAFT")
  publishedAt  DateTime?
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  client       Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  hero         Media?          @relation("ProjectHero", fields: [heroId], references: [id], onDelete: SetNull)
  media        ProjectMedia[]
  results      ProjectResult[]
  testimonials Testimonial[]

  @@index([status, publishedAt])
  @@index([category])
  @@index([isFeatured])
}

model ProjectMedia {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  projectId String  @db.ObjectId
  mediaId   String  @db.ObjectId
  caption   String?
  /// image | video | before | after
  kind      String  @default("image")
  order     Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

/// Measurable outcomes. Kept as separate rows so a case study with no verified
/// numbers simply renders no results block rather than showing placeholders.
model ProjectResult {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  projectId String  @db.ObjectId
  label     String
  value     String
  note      String?
  order     Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

/// status: LIVE | BETA | COMING_SOON
model Product {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  slug            String    @unique
  name            String
  tagline         String    @default("")
  description     String    @default("")
  category        String?
  platform        String?
  status          String    @default("COMING_SOON")
  websiteUrl      String?
  pricingUrl      String?
  videoUrl        String?
  ctaLabel        String?
  ctaHref         String?
  /// JSON TEXT — array of { title, body }
  features        String    @default("[]")
  logoId          String?   @db.ObjectId
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean   @default(false)
  order           Int       @default(0)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  logo  Media?         @relation("ProductLogo", fields: [logoId], references: [id], onDelete: SetNull)
  media ProductMedia[]

  @@index([isPublished, order])
}

model ProductMedia {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  productId String  @db.ObjectId
  mediaId   String  @db.ObjectId
  caption   String?
  order     Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([productId, order])
}

model Testimonial {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  quote       String
  authorName  String
  position    String?
  company     String?
  country     String?
  rating      Int?
  photoId     String?  @db.ObjectId
  clientId    String?  @db.ObjectId
  projectId   String?  @db.ObjectId
  videoUrl    String?
  /// Marks content carried over from the previous site so an administrator can
  /// see what still needs verifying against the original source.
  isMigrated  Boolean  @default(false)
  isPublished Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  photo   Media?   @relation("TestimonialPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([isPublished, order])
}

model TeamMember {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  slug        String   @unique
  name        String
  role        String
  bio         String?
  photoId     String?  @db.ObjectId
  linkedin    String?
  /// JSON TEXT — array of strings
  expertise   String   @default("[]")
  isPublished Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  photo Media? @relation("TeamPhoto", fields: [photoId], references: [id], onDelete: SetNull)

  @@index([isPublished, order])
}

// ---------------------------------------------------------------------------
// Insights
// ---------------------------------------------------------------------------

model Category {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  slug        String  @unique
  name        String
  description String?
  order       Int     @default(0)

  posts Post[]
}

model Tag {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  slug String @unique
  name String

  posts PostTag[]
}

model PostTag {
  /// MongoDB has no composite primary key, so the join row carries its own
  /// `_id` and the pair is enforced by a unique index instead. Every query the
  /// application makes is unchanged.
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  postId String @db.ObjectId
  tagId  String @db.ObjectId

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
}

/// status: DRAFT | PUBLISHED | SCHEDULED | ARCHIVED
model Post {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  slug            String    @unique
  title           String
  excerpt         String    @default("")
  /// Markdown
  content         String    @default("")
  heroId          String?   @db.ObjectId
  authorId        String?   @db.ObjectId
  categoryId      String?   @db.ObjectId
  status          String    @default("DRAFT")
  publishedAt     DateTime?
  readingMinutes  Int       @default(1)
  metaTitle       String?
  metaDescription String?
  isFeatured      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hero     Media?    @relation("PostHero", fields: [heroId], references: [id], onDelete: SetNull)
  author   User?     @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags     PostTag[]

  @@index([status, publishedAt])
  @@index([categoryId])
}

/// Scoped FAQs. `scopeType`/`scopeKey` let an administrator attach questions to
/// a service, industry, market or the general contact page.
model Faq {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  question    String
  answer      String
  /// service | industry | location | general
  scopeType   String   @default("general")
  scopeKey    String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scopeType, scopeKey, order])
}

/// Flexible CMS pages built from ordered blocks, for content that should not
/// require a developer. `blocks` is JSON TEXT: an array of { type, props }.
model Page {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  slug            String    @unique
  title           String
  blocks          String    @default("[]")
  status          String    @default("DRAFT")
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  noindex         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

/// status: NEW | CONTACTED | QUALIFIED | PROPOSAL | WON | LOST | SPAM
model Lead {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String
  phone        String?
  company      String?
  country      String?
  /// JSON TEXT — array of selected service slugs
  services     String   @default("[]")
  budget       String?
  timeline     String?
  message      String   @default("")
  sourcePage   String?
  referrer     String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?
  status       String   @default("NEW")
  assignedToId String?  @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedTo User?      @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes      LeadNote[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([email])
}

model LeadNote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  leadId    String   @db.ObjectId
  userId    String?  @db.ObjectId
  body      String
  createdAt DateTime @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

/// Simple persistent counter used for form rate limiting. Kept in the database
/// so limits survive a restart and work across instances.
model RateLimit {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  bucket     String
  identifier String
  count      Int      @default(0)
  expiresAt  DateTime

  @@unique([bucket, identifier])
  @@index([expiresAt])
}

/// An open role. The careers page states plainly when there are none rather
/// than running a permanently open advert, so this table being empty is a
/// supported state and not a gap.
///
/// Portable by the same rules as the rest of the schema: no native enums, no
/// Json columns, no scalar lists. `status` and `employmentType` are strings
/// validated by Zod at the edge.
model JobOpening {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  slug             String    @unique
  title            String
  /// FULL_TIME | PART_TIME | CONTRACT | INTERNSHIP
  employmentType   String    @default("FULL_TIME")
  /// ON_SITE | HYBRID | REMOTE
  workplace        String    @default("HYBRID")
  location         String?
  summary          String
  /// Markdown. Rendered through the same sanitiser as posts.
  description      String    @default("")
  /// Newline-separated, kept as TEXT for the same portability reason.
  responsibilities String    @default("")
  requirements     String    @default("")
  salaryRange      String?
  applyEmail       String?
  applyUrl         String?
  /// DRAFT | PUBLISHED | CLOSED
  status           String    @default("DRAFT")
  publishedAt      DateTime?
  closesAt         DateTime?
  metaTitle        String?
  metaDescription  String?
  orderIndex       Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, orderIndex])
}

/// A single field of page copy, overridden from the admin.
///
/// The typed content files in `src/content` stay the source of truth and the
/// default. This table only holds fields somebody has deliberately changed, so
/// an empty table means the site renders exactly as the code says — which
/// makes the whole feature safe to add to a site already in production.
///
/// Field-level rather than a JSON blob per page, matching SeoOverride: it makes
/// "reset this one field back to the code default" a row delete, and it shows
/// in the admin exactly which copy has diverged from the repository.
model ContentOverride {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  /// service | industry | location | page
  scope     String
  /// A slug for scoped content, or a path like "/about" for a static page.
  entryKey  String
  /// A field name declared in `src/content/editable.ts`. Anything not in that
  /// registry is ignored on read, so a stale row cannot inject unknown copy.
  field     String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([scope, entryKey, field])
  @@index([scope, entryKey])
}
